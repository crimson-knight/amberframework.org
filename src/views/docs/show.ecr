<% page = @page.not_nil! %>
<% version = @version %>
<% @title = "#{page.title} — Amber Framework documentation" %>
<% @meta = page.description.empty? ? "Amber Framework documentation" : page.description %>

<header class="docs-page-banner">
  <div class="site-container docs-page-banner-inner">
    <div>
      <p class="eyebrow">Documentation</p>
      <h1><%= page.title %></h1>
    </div>
    <div class="docs-page-banner-meta">
      <% if badge = @page_badge %><span class="badge <%= @page_badge_class %>"><%= badge %></span><% end %>
    </div>
  </div>
</header>

<main class="docs-shell">
  <aside class="docs-sidebar">
    <%= render(partial: "docs/_sidebar.ecr") %>
  </aside>

  <div class="docs-main">
    <details class="docs-mobile-nav">
      <summary>Browse documentation</summary>
      <%= render(partial: "docs/_sidebar.ecr") %>
    </details>

    <div class="docs-toolbar">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/docs/latest">Docs</a>
        <% if version %>
          <span class="separator">/</span>
          <a href="/docs/<%= @version_id %>"><%= version.label %></a>
        <% end %>
        <% @breadcrumbs.each do |crumb| %>
          <span class="separator">/</span>
          <a href="/docs/<%= crumb[:path] %>"><%= crumb[:title] %></a>
        <% end %>
      </nav>
      <div class="docs-actions-list" aria-label="Page tools">
        <% machine_path = @path.empty? ? "/docs/#{@version_id}" : "/docs/#{@version_id}/#{@path}" %>
        <button class="docs-action-button" type="button" data-copy-page data-raw-url="<%= machine_path %>.md"><span class="docs-markdown-icon" aria-hidden="true">M↓</span><span data-copy-label>Copy as Markdown</span></button>
        <a class="docs-action-button" href="<%= machine_path %>.md" target="_blank" rel="noopener"><span class="docs-markdown-icon" aria-hidden="true">M↗</span><span>View Markdown</span></a>
        <a class="docs-action-button" href="<%= machine_path %>.json" target="_blank" rel="noopener"><span class="docs-markdown-icon" aria-hidden="true">{ }</span><span>View JSON</span></a>
        <a class="docs-action-button" href="https://claude.ai/new" target="_blank" rel="noopener" data-open-docs-ai="claude" data-docs-title="<%= page.title %>" data-raw-url="<%= machine_path %>.md"><img src="/assets/brand/claude-icon-rounded.svg" width="18" height="18" alt=""><span>Open in Claude</span></a>
        <a class="docs-action-button" href="https://chatgpt.com/" target="_blank" rel="noopener" data-open-docs-ai="chatgpt" data-docs-title="<%= page.title %>" data-raw-url="<%= machine_path %>.md"><span class="openai-icon" aria-hidden="true"><img src="/assets/brand/openai-symbol-2025.svg" width="18" height="18" alt=""></span><span>Open in ChatGPT</span></a>
        <a class="docs-action-button" href="https://gemini.google.com/app" target="_blank" rel="noopener" data-open-docs-ai="gemini" data-docs-title="<%= page.title %>" data-raw-url="<%= machine_path %>.md"><span class="gemini-icon" aria-hidden="true">✦</span><span>Open in Gemini</span></a>
      </div>
    </div>
    <p class="docs-tools-note">Read this page as HTML, Markdown, or structured JSON—or open the published Markdown with an AI assistant. Copying works in local previews; external assistants need the public site URL.</p>

    <aside class="docs-guide-moment" aria-label="Amber guide note">
      <img src="/assets/characters/amber-chibi-hero-mark-v2.webp" width="180" height="180" alt="Chibi Amber giving a peace sign">
      <div>
        <% if @is_inherited %>
          <strong>Stable framework reference</strong>
          <p>This page has no change badge because its framework concept remains unchanged. Follow V2 installation, CLI, templates, assets, and persistence guides whenever they differ.</p>
        <% else %>
          <strong>Amber's guide note</strong>
          <p>This guide is written for Amber V2. The version timeline marks older material as available, replaced, or unavailable.</p>
        <% end %>
      </div>
    </aside>

    <%= render(partial: "docs/_version_timeline.ecr") %>

    <article class="docs-content">
      <%= render_markdown(page.content) %>
    </article>

    <nav class="prev-next-nav" aria-label="Previous and next documentation pages">
      <div>
        <% if prev_page = @prev_page %>
          <a class="prev-next-link" href="/docs/<%= prev_page.url_path %>">
            <small>Previous</small>
            <strong><%= prev_page.title %></strong>
          </a>
        <% end %>
      </div>
      <div>
        <% if next_page = @next_page %>
          <a class="prev-next-link next" href="/docs/<%= next_page.url_path %>">
            <small>Next</small>
            <strong><%= next_page.title %></strong>
          </a>
        <% end %>
      </div>
    </nav>
  </div>
</main>
