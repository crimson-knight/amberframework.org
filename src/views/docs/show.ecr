<% page = @page.not_nil! %>
<% version = @version %>
<% @title = "#{page.title} — Amber Framework documentation" %>
<% @meta = page.description.empty? ? "Amber Framework documentation" : page.description %>

<header class="page-hero">
  <div class="site-container">
    <p class="eyebrow">Amber Framework documentation</p>
    <h1><%= page.title %></h1>
    <p><%= version.try(&.label) || "Versioned guide" %><% if @is_inherited %> <span class="badge badge-inherited">Carried forward</span><% elsif badge = @page_badge %> <span class="badge <%= @page_badge_class %>"><%= badge %></span><% end %></p>
  </div>
</header>

<main class="docs-shell">
  <aside class="docs-sidebar">
    <%= render(partial: "docs/_sidebar.ecr") %>
  </aside>

  <div class="docs-main">
    <details class="docs-mobile-nav">
      <summary>Browse documentation</summary>
      <%= render(partial: "docs/_sidebar.ecr") %>
    </details>

    <div class="docs-toolbar">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/docs/latest">Docs</a>
        <% if version %>
          <span class="separator">/</span>
          <a href="/docs/<%= @version_id %>"><%= version.label %></a>
        <% end %>
        <% @breadcrumbs.each do |crumb| %>
          <span class="separator">/</span>
          <a href="/docs/<%= crumb[:path] %>"><%= crumb[:title] %></a>
        <% end %>
      </nav>
      <details class="docs-actions">
        <summary>Page tools <span aria-hidden="true">▾</span></summary>
        <div class="docs-actions-menu">
          <button type="button" data-copy-page data-raw-url="/docs/raw/<%= @version_id %>/<%= @path %>">Copy as Markdown</button>
          <a href="/docs/raw/<%= @version_id %>/<%= @path %>" target="_blank" rel="noopener">View as Markdown</a>
          <a href="https://claude.ai/new" target="_blank" rel="noopener" data-open-docs-ai="claude" data-docs-title="<%= page.title %>" data-raw-url="/docs/raw/<%= @version_id %>/<%= @path %>">Open in Claude</a>
          <a href="https://chatgpt.com/" target="_blank" rel="noopener" data-open-docs-ai="chatgpt" data-docs-title="<%= page.title %>" data-raw-url="/docs/raw/<%= @version_id %>/<%= @path %>">Open in ChatGPT</a>
        </div>
      </details>
    </div>

    <div class="docs-title-row">
      <h1><%= page.title %></h1>
      <p class="docs-kicker"><%= version.try(&.description) || "Amber Framework guide" %></p>
    </div>

    <aside class="docs-guide-moment" aria-label="Amber guide note">
      <img src="/assets/characters/amber-chibi-original-studio.webp" width="180" height="180" alt="Amber holding a laptop and pointing toward the guide">
      <div>
        <% if @is_inherited %>
          <strong>Carried forward from Amber 1.4.1</strong>
          <p>This framework concept still applies in V2, but this page has not received a V2-specific rewrite. Follow V2 installation, CLI, templates, assets, and persistence guides whenever they differ.</p>
        <% else %>
          <strong>Amber's guide note</strong>
          <p>This page is authored or reviewed for V2. Use the version timeline to move between stable, carried-forward, replaced, and unavailable material.</p>
        <% end %>
      </div>
    </aside>

    <%= render(partial: "docs/_version_timeline.ecr") %>

    <article class="docs-content">
      <%= render_markdown(page.content) %>
    </article>

    <nav class="prev-next-nav" aria-label="Previous and next documentation pages">
      <div>
        <% if prev_page = @prev_page %>
          <a class="prev-next-link" href="/docs/<%= prev_page.url_path %>">
            <small>Previous</small>
            <strong><%= prev_page.title %></strong>
          </a>
        <% end %>
      </div>
      <div>
        <% if next_page = @next_page %>
          <a class="prev-next-link next" href="/docs/<%= next_page.url_path %>">
            <small>Next</small>
            <strong><%= next_page.title %></strong>
          </a>
        <% end %>
      </div>
    </nav>
  </div>
</main>
