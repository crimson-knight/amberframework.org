<div class="docs-sidebar-inner">
  <%= render(partial: "docs/_version_selector.ecr") %>
  <nav class="sidebar-nav" aria-label="Documentation pages">
    <h2 class="sidebar-heading">Documentation</h2>
    <ul class="nav-tree">
      <% @nav_tree.each do |item| %>
        <% full_path = "#{@version_id}/#{@path}" %>
        <% is_active = item.path == full_path || full_path.starts_with?(item.path + "/") %>
        <li>
          <a class="<%= "active" if is_active %>" href="/docs/<%= item.path %>">
            <span><%= item.title %></span>
            <% if badge = item.badge %><span class="badge <%= item.badge_class %>"><%= badge %></span><% end %>
          </a>
          <% unless item.children.empty? %>
            <ul class="nav-children">
              <% item.children.each do |child| %>
                <% child_active = child.path == full_path || full_path.starts_with?(child.path + "/") %>
                <li>
                  <a class="<%= "active" if child_active %>" href="/docs/<%= child.path %>">
                    <span><%= child.title %></span>
                    <% if badge = child.badge %><span class="badge <%= child.badge_class %>"><%= badge %></span><% end %>
                  </a>
                  <% unless child.children.empty? %>
                    <ul class="nav-children">
                      <% child.children.each do |grandchild| %>
                        <% grandchild_active = grandchild.path == full_path %>
                        <li>
                          <a class="<%= "active" if grandchild_active %>" href="/docs/<%= grandchild.path %>">
                            <span><%= grandchild.title %></span>
                            <% if badge = grandchild.badge %><span class="badge <%= grandchild.badge_class %>"><%= badge %></span><% end %>
                          </a>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
</div>
