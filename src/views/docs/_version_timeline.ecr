<% if @show_version_timeline && @version_timeline.size > 1 %>
  <div class="version-timeline" aria-label="Document version history">
    <div class="version-timeline-track">
      <% @version_timeline.each do |entry| %>
        <% status_class = version_timeline_status_class(entry) %>
        <% current_class = entry[:is_current] ? "current" : "" %>
        <div class="version-timeline-segment <%= status_class %> <%= current_class %>" title="<%= version_timeline_tooltip(entry) %>">
          <% if entry[:exists] %>
            <a class="segment-link" href="/docs/<%= entry[:version_id] %>/<%= @path %>">
              <div class="segment-bar"></div>
              <div class="segment-label"><%= entry[:short_label] %></div>
            </a>
          <% else %>
            <div class="segment-bar unavailable"></div>
            <div class="segment-label"><%= entry[:short_label] %></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
