<% character_id = params["id"] %>
<% if character_id == "grant" %>
  <% character_name = "Grant" %>
  <% character_number = "AF-014" %>
  <% character_role = "Records and logistics" %>
  <% character_class = "grant" %>
  <% character_image = "/assets/characters/grant-id-original-studio.webp" %>
  <% character_docs = "/docs/v2/guides/models/grant" %>
  <% character_summary = "Grant is the data specialist—the warehouse manager who knows where every record belongs and how it got there." %>
  <% character_personality = "Calm, exact, and quietly confident. Grant prefers a clear schema, an auditable migration, and a query whose intent can be read without a scavenger hunt." %>
  <% character_responsibilities = ["Models and relations", "Migrations and schema evolution", "Queries and transactions", "Validation and record integrity"] %>
  <% character_line = "If the business needs to remember it, Grant gives it a reliable place to live." %>
<% elsif character_id == "gemma" %>
  <% character_name = "Gemma" %>
  <% character_number = "AF-027" %>
  <% character_role = "Files and fulfillment" %>
  <% character_class = "gemma" %>
  <% character_image = "/assets/characters/gemma-id-original-studio.webp" %>
  <% character_docs = "/docs/v2/guides/uploads" %>
  <% character_summary = "Gemma owns the things that have to move, land safely, and remain findable: uploads, attachments, storage, and delivery." %>
  <% character_personality = "Fast, resourceful, and unflappable when the payload is large. Gemma likes explicit limits, verified formats, and storage adapters that can change without rewriting the app." %>
  <% character_responsibilities = ["File attachments", "Storage adapters", "Validation and limits", "Streaming and delivery"] %>
  <% character_line = "From upload to delivery, Gemma keeps every file accounted for." %>
<% else %>
  <% character_name = "Amber" %>
  <% character_number = "AF-001" %>
  <% character_role = "Framework lead and front office" %>
  <% character_class = "amber" %>
  <% character_image = "/assets/characters/amber-id-original-studio.webp" %>
  <% character_docs = "/docs/v2" %>
  <% character_summary = "Amber turns the business idea into the application people can see and use. She owns the web framework and leads the crew." %>
  <% character_personality = "Warm, energetic, decisively helpful, and a little opinionated about clear conventions. Amber wants the first path to work completely before asking a developer to assemble options." %>
  <% character_responsibilities = ["Routing and controllers", "ECR views and presentation", "Interaction and asset delivery", "Application structure and configuration"] %>
  <% character_line = "Tell Amber what the business needs to do; she will give it a clear place in the app." %>
<% end %>

<% @title = "#{character_name} — Amber Framework character" %>
<% @meta = "Meet #{character_name}, #{character_role.downcase} in the Amber Framework ecosystem." %>

<main class="character-profile character-<%= character_class %>">
  <section class="character-profile-hero">
    <div class="site-container character-profile-grid">
      <div class="character-profile-copy">
        <a class="text-link" href="/characters">← Crew directory</a>
        <p class="eyebrow"><%= character_number %> · <%= character_role %></p>
        <h1><%= character_name %></h1>
        <p class="character-deck"><%= character_summary %></p>
        <div class="hero-actions">
          <a class="button button-primary" href="<%= character_docs %>">Read <%= character_name %>'s docs</a>
          <a class="button button-secondary" href="/amber-way">Learn Amber's Way</a>
        </div>
      </div>
      <div class="character-portrait-frame">
        <span class="id-corner top-left"></span><span class="id-corner top-right"></span>
        <img src="<%= character_image %>" width="1024" height="1024" alt="Portrait of <%= character_name %>">
        <div class="portrait-stamp"><strong><%= character_number %></strong><span>OPEN SOURCE CREW</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container profile-details-grid">
      <article class="profile-memo reveal">
        <p class="file-label">Working style</p>
        <h2>How <%= character_name %> shows up</h2>
        <p><%= character_personality %></p>
        <blockquote><%= character_line %></blockquote>
      </article>
      <article class="profile-memo reveal">
        <p class="file-label">Responsibility map</p>
        <h2>What belongs here</h2>
        <ul class="responsibility-list">
          <% character_responsibilities.each do |responsibility| %>
            <li><span aria-hidden="true">◆</span><%= responsibility %></li>
          <% end %>
        </ul>
        <p class="boundary-note">The character is shorthand for a software boundary, not a substitute for the API documentation.</p>
      </article>
    </div>
  </section>
</main>
